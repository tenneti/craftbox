{
  "$id": "filmcraft.input.cinematography.v1",
  "title": "Cinematography input: scene artifact plus explicit camera decisions",
  "type": "object",
  "required": ["scene", "shots"],
  "properties": {
    "scene": {"$ref": "filmcraft.scene.v1"},
    "shots": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["shot_id", "duration_frames", "lens_mm"],
        "properties": {
          "shot_id": {"type": "string", "pattern": "\\S"},
          "shot_type": {"type": "string"},
          "duration_frames": {"type": "integer", "minimum": 1, "maximum": 100000},
          "lens_mm": {"type": "number", "minimum": 1, "maximum": 2000},
          "camera_movement": {"type": "string"},
          "subject": {"type": "string"},
          "media_asset_id": {"type": ["string", "null"]}
        }
      }
    }
  }
}
