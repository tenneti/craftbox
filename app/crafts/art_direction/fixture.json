    "scenes": [
      {
        "id": "SC-001",
        "sequence_id": "SEQ-1",
        "heading": {
          "int_ext": "INT.",
          "location": "Page & Candle Bookshop",
          "time": "Night"
        },
        "synopsis": "Nila returns a borrowed paperback minutes after closing; Arjun makes her open it.",
        "objective": "Nila wants to hand back the book and leave without feeling anything. Arjun wants to get through closing without a scene.",
        "conflict": "Pride and fear. Each is waiting for the other to speak first, and both are hiding behind small talk.",
        "turning_point": "Arjun makes her open the book: inside is a train ticket to her city that he bought and never used.",
        "outcome": "She does not answer his question. She takes the ticket, leaves the book, and turns the sign to OPEN on her way out.",
        "characters": [
          "C-001",
          "C-002"
        ],
        "props": [
          {
            "id": "P-COUNTER",
            "name": "Counter with till"
          },
          {
            "id": "P-DOOR",
            "name": "Shop door"
          },
          {
            "id": "P-SHELF",
            "name": "Crooked shelf of poetry"
          },
          {
            "id": "P-BOOK",
            "name": "Worn paperback"
          },
          {
            "id": "P-SIGN",
            "name": "CLOSED / OPEN sign"
          }
        ],
        "elements": [
          {
            "id": "SC-001-E01",
            "type": "action",
            "character_id": null,
            "text": "Rain ticks on the window. ARJUN counts the till, alone, one lamp lit."
          },
          {
            "id": "SC-001-E02",
            "type": "action",
            "character_id": null,
            "text": "The door chimes. NILA enters, shaking rain from her coat, a worn paperback in her hand."
          },
          {
            "id": "SC-001-E03",
            "type": "dialogue",
            "character_id": "C-002",
            "text": "We're closed."
          },
          {
            "id": "SC-001-E04",
            "type": "dialogue",
            "character_id": "C-001",
            "text": "I know. I only need a minute."
          },
          {
            "id": "SC-001-E05",
            "type": "action",
            "character_id": null,
            "text": "She sets the paperback on the counter. He doesn't touch it."
          },
          {
            "id": "SC-001-E06",
            "type": "dialogue",
            "character_id": "C-001",
            "text": "It's yours. I kept it two years. Longer than I meant to."
          },
          {
            "id": "SC-001-E07",
            "type": "parenthetical",
            "character_id": "C-002",
            "text": "too lightly"
          },
          {
            "id": "SC-001-E08",
            "type": "dialogue",
            "character_id": "C-002",
            "text": "You could have mailed it."
          },
          {
            "id": "SC-001-E09",
            "type": "dialogue",
            "character_id": "C-001",
            "text": "Then I wouldn't have had to see the shop."
          },
          {
            "id": "SC-001-E10",
            "type": "action",
            "character_id": null,
            "text": "A pause. The rain fills it. Nila's eyes drift to a crooked shelf of poetry."
          },
          {
            "id": "SC-001-E11",
            "type": "dialogue",
            "character_id": "C-001",
            "text": "You never fixed that shelf."
          },
          {
            "id": "SC-001-E12",
            "type": "dialogue",
            "character_id": "C-002",
            "text": "It leans toward the door. Waiting for someone to leave."
          },
          {
            "id": "SC-001-E13",
            "type": "action",
            "character_id": null,
            "text": "Nila laughs, small, then stops herself. She turns to go."
          },
          {
            "id": "SC-001-E14",
            "type": "dialogue",
            "character_id": "C-002",
            "text": "Nila. Open it."
          },
          {
            "id": "SC-001-E15",
            "type": "action",
            "character_id": null,
            "text": "She stops. He nods at the book. She opens it. Inside: a train ticket to her city, two years old, unused."
          },
          {
            "id": "SC-001-E16",
            "type": "dialogue",
            "character_id": "C-001",
            "text": "You bought this."
          },
          {
            "id": "SC-001-E17",
            "type": "dialogue",
            "character_id": "C-002",
            "text": "The day after you left. I stood on the platform until the train pulled away."
          },
          {
            "id": "SC-001-E18",
            "type": "dialogue",
            "character_id": "C-001",
            "text": "Why tell me now?"
          },
          {
            "id": "SC-001-E19",
            "type": "dialogue",
            "character_id": "C-002",
            "text": "Because you leave at dawn, and I'm still counting the till."
          },
          {
            "id": "SC-001-E20",
            "type": "action",
            "character_id": null,
            "text": "Nila folds the ticket along its old crease. Her hand trembles. His does too."
          },
          {
            "id": "SC-001-E21",
            "type": "dialogue",
            "character_id": "C-001",
            "text": "Ask me."
          },
          {
            "id": "SC-001-E22",
            "type": "dialogue",
            "character_id": "C-002",
            "text": "Stay.",
            "pause_seconds": 1.5
          },
          {
            "id": "SC-001-E23",
            "type": "action",
            "character_id": null,
            "text": "She holds his gaze. Doesn't answer. Pockets the ticket, leaves the book on the counter, and walks to the door."
          },
          {
            "id": "SC-001-E24",
            "type": "action",
            "character_id": null,
            "text": "At the threshold she stops, turns the CLOSED sign to OPEN, and steps out into the rain, leaving the door ajar."
          }
        ],
