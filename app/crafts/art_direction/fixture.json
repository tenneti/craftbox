          "purpose": "The returned book opens the old wound."
        },
        {
          "act": 3,
          "label": "Resolution",
          "purpose": "The question is finally asked; the answer stays open."
        }
      ]
    },
    "sequences": [
      {
        "id": "SEQ-1",
