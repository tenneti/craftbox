{
  "screenplay": {
    "schema": "filmcraft.screenplay.v1",
    "project": {
      "id": "closing-hour",
      "title": "The Closing Hour",
      "logline": "On the night before she leaves the city for good, a translator returns a borrowed book to the bookshop owner she once loved, and learns what he kept.",
      "genre": "Romantic drama",
      "theme": "What we keep instead of asking for what we want",
      "story_idea": "Two people who loved each other and never said the one thing that mattered get one quiet closing hour.",
      "fps": 24
    },
    "revision": {
      "number": 1,
      "note": "First complete draft of the test scene"
    },
    "characters": [
      {
        "id": "C-001",
        "name": "Nila",
        "role": "Protagonist",
        "age_range": "early 30s",
        "description": "A translator, precise with other people's words and careful with her own. Leaving the city at dawn.",
        "motivation": "To close the chapter with dignity and without being seen to need anyone.",
        "want": "To return the book and leave unaffected.",
        "need": "To say aloud what she never said.",
        "flaw": "Pride; she deflects with precision.",
        "relationships": [
          {
            "character_id": "C-002",
            "relation": "Former love; she ended it two years ago",
            "tension": "Unspoken regret on both sides"
          }
        ],
        "emotional_arc": {
          "start": "Controlled, brisk",
          "end": "Open, undecided"
        }
      },
      {
        "id": "C-002",
        "name": "Arjun",
        "role": "Deuteragonist",
        "age_range": "mid 30s",
        "description": "Runs his late father's bookshop. Hides in routine; keeps things instead of asking for them.",
        "motivation": "To keep the evening ordinary so that nothing can be lost in it.",
        "want": "To get through closing time without a scene.",
        "need": "To ask her to stay.",
        "flaw": "Fear of asking; he waits to be chosen.",
        "relationships": [
          {
            "character_id": "C-001",
            "relation": "The one who did not follow her",
            "tension": "He has rehearsed this meeting for two years"
          }
        ],
        "emotional_arc": {
          "start": "Casual, guarded",
          "end": "Exposed, hopeful"
        }
      }
    ],
    "structure": {
      "acts": [
        {
          "act": 1,
          "label": "Setup",
          "purpose": "Introduce the people, the place and what each is hiding."
        },
