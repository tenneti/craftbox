{
  "$id": "filmcraft.edit_plan.v1",
  "title": "Offline edit plan artifact (editing output)",
  "type": "object",
  "required": ["schema", "project_id", "scene_id", "fps", "clips", "total_frames", "total_seconds"],
  "properties": {
    "schema": {"const": "filmcraft.edit_plan.v1"},
    "project_id": {"type": "string", "minLength": 1},
    "scene_id": {"type": "string", "minLength": 1},
    "fps": {"type": "integer", "minimum": 1, "maximum": 120},
    "total_frames": {"type": "integer", "minimum": 0},
    "total_seconds": {"type": "number", "minimum": 0},
    "clips": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["shot_id", "start_frame", "duration_frames"],
        "properties": {
          "shot_id": {"type": "string", "minLength": 1},
          "scene_id": {"type": "string"},
          "start_frame": {"type": "integer", "minimum": 0},
          "duration_frames": {"type": "integer", "minimum": 1},
          "media_asset_id": {"type": ["string", "null"]}
        }
      }
    }
  }
}
