{
  "$id": "filmcraft.light.v1",
  "title": "One light source in a lighting plan: stage position, direction, intensity, colour temperature, beam angle, softness and falloff",
  "type": "object",
  "required": ["id", "name", "role", "source", "x", "y", "intensity", "color_temp_k", "beam_angle_deg", "softness", "falloff"],
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$", "maxLength": 40},
    "name": {"type": "string", "minLength": 1, "maxLength": 120},
    "role": {"enum": ["key", "fill", "backlight", "rim", "practical", "ambient", "motivated"]},
    "source": {"enum": ["natural", "artificial"]},
    "kind": {"type": "string", "maxLength": 40},
    "x": {"type": "number", "minimum": -0.5, "maximum": 1.5},
    "y": {"type": "number", "minimum": -0.5, "maximum": 1.5},
    "height_m": {"type": "number", "minimum": 0, "maximum": 12},
    "rotation_deg": {"type": "number", "minimum": 0, "maximum": 360},
    "tilt_deg": {"type": "number", "minimum": -90, "maximum": 90},
    "intensity": {"type": "number", "minimum": 0, "maximum": 1},
    "color_temp_k": {"type": "number", "minimum": 1000, "maximum": 20000},
    "beam_angle_deg": {"type": "number", "minimum": 5, "maximum": 360},
    "softness": {"type": "number", "minimum": 0, "maximum": 1},
    "falloff": {"type": "object", "required": ["mode"], "properties": {"mode": {"enum": ["inverse_square", "linear", "none"]}, "range_m": {"type": "number", "minimum": 0.5, "maximum": 60}}},
    "enabled": {"type": "boolean"},
    "positional": {"type": "boolean"},
    "motivated_by": {"type": "string"},
    "practical_object_id": {"type": "string"},
    "narrative_purpose": {"type": "string"},
    "notes": {"type": "string"},
    "status": {"enum": ["proposed", "approved", "needs_review"]},
    "previous_status": {"enum": ["proposed", "approved", "needs_review"]}
  }
}
