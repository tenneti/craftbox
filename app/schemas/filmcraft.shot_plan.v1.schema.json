{
  "$id": "filmcraft.shot_plan.v1",
  "title": "Shot plan artifact (cinematography output)",
  "type": "object",
  "required": ["schema", "project_id", "scene_id", "fps", "shots", "total_frames"],
  "properties": {
    "schema": {"const": "filmcraft.shot_plan.v1"},
    "project_id": {"type": "string", "minLength": 1},
    "scene_id": {"type": "string", "minLength": 1},
    "fps": {"type": "integer", "minimum": 1, "maximum": 120},
    "total_frames": {"type": "integer", "minimum": 1},
    "shots": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["shot_id", "duration_frames", "lens_mm"],
        "properties": {
          "shot_id": {"type": "string", "minLength": 1},
          "scene_id": {"type": "string"},
          "shot_type": {"type": "string"},
          "duration_frames": {"type": "integer", "minimum": 1},
          "lens_mm": {"type": "number", "minimum": 1, "maximum": 2000},
          "camera_movement": {"type": "string"},
          "subject": {"type": "string"},
          "media_asset_id": {"type": ["string", "null"]}
        }
      }
    }
  }
}
