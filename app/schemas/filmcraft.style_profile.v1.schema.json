{
  "$id": "filmcraft.style_profile.v1",
  "title": "Reusable project-level visual style profile with project-specific creative constraints",
  "type": "object",
  "required": ["schema", "project_id", "profile"],
  "properties": {
    "schema": {"const": "filmcraft.style_profile.v1"},
    "project_id": {"type": "string", "minLength": 1},
    "note": {"type": "string"},
    "profile": {
      "type": "object",
      "required": ["id", "name"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$", "maxLength": 40},
        "name": {"type": "string", "minLength": 1, "maxLength": 120},
        "summary": {"type": "string"},
        "palette": {"type": "array", "items": {"type": "object", "required": ["id", "name", "hex"], "properties": {"id": {"type": "string"}, "name": {"type": "string", "minLength": 1}, "hex": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"}, "role": {"type": "string"}}}},
        "textures": {"type": "array", "items": {"type": "object", "required": ["id", "name"], "properties": {"id": {"type": "string"}, "name": {"type": "string", "minLength": 1}, "description": {"type": "string"}}}},
        "materials": {"type": "array", "items": {"type": "object", "required": ["id", "name"], "properties": {"id": {"type": "string"}, "name": {"type": "string", "minLength": 1}, "finish": {"type": "string"}, "notes": {"type": "string"}}}},
        "period": {"type": "object", "properties": {"era": {"type": "string"}, "notes": {"type": "string"}}},
        "themes": {"type": "array", "items": {"type": "string"}},
        "mood_words": {"type": "array", "items": {"type": "string"}},
        "constraints": {"type": "array", "items": {"type": "object", "required": ["id", "kind", "term"], "properties": {"id": {"type": "string"}, "kind": {"enum": ["avoid", "require"]}, "term": {"type": "string", "minLength": 2}, "note": {"type": "string"}}}}
      }
    },
    "analysis": {"type": "object"}
  }
}
