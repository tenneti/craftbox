# ---- Python environments and caches ----
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.pyd
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/

# ---- Secrets, keys, credentials (Craftbox reads API keys from environment variables only) ----
.env
.env.*
!.env.example
*.pem
*.key
*.pfx
*.p12
*.crt
secrets/
credentials*.json
*token*.json
*.secret

# ---- Local runtime data: databases, logs, stored assets (needed to run, never committed) ----
data/
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.log
*.part
*.tmp
*.bak
*.swp
~$*
.cache/
tmp/
temp/

# ---- Generated output (rebuild with scripts/make_*_samples.py or the app) ----
output/
outputs/
renders/
generated/
exports/
pilot-edit-plan.json

# ---- Generated or downloaded media (video, audio, 3D, large binaries) ----
*.mp4
*.mov
*.mkv
*.avi
*.webm
*.wav
*.mp3
*.flac
*.exr
*.blend
*.psd

# ---- Model weights and large downloaded assets ----
models/
weights/
checkpoints/
*.safetensors
*.ckpt
*.pt
*.pth
*.onnx
*.gguf
*.bin
*.zip
*.7z
*.tar
*.tar.gz

# ---- Playwright / browser-test artifacts ----
test-results/
playwright-report/
traces/
screenshots/

# ---- Editor and OS files ----
.vscode/
.idea/
Thumbs.db
desktop.ini
