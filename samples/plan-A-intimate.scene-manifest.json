  "characters": [
    {
      "age_range": "early 30s",
      "description": "A translator, precise with other people's words and careful with her own. Leaving the city at dawn.",
      "emotional_arc": {
        "end": "Open, undecided",
        "start": "Controlled, brisk"
      },
      "flaw": "Pride; she deflects with precision.",
      "id": "C-001",
      "motivation": "To close the chapter with dignity and without being seen to need anyone.",
      "name": "Nila",
      "need": "To say aloud what she never said.",
      "relationships": [
        {
          "character_id": "C-002",
          "relation": "Former love; she ended it two years ago",
          "tension": "Unspoken regret on both sides"
        }
      ],
      "role": "Protagonist",
      "want": "To return the book and leave unaffected."
    },
    {
      "age_range": "mid 30s",
      "description": "Runs his late father's bookshop. Hides in routine; keeps things instead of asking for them.",
      "emotional_arc": {
        "end": "Exposed, hopeful",
        "start": "Casual, guarded"
      },
      "flaw": "Fear of asking; he waits to be chosen.",
      "id": "C-002",
      "motivation": "To keep the evening ordinary so that nothing can be lost in it.",
      "name": "Arjun",
      "need": "To ask her to stay.",
      "relationships": [
        {
          "character_id": "C-001",
          "relation": "The one who did not follow her",
          "tension": "He has rehearsed this meeting for two years"
        }
      ],
      "role": "Deuteragonist",
      "want": "To get through closing time without a scene."
    }
  ],
  "elements": [
    {
      "character_id": null,
      "id": "SC-001-E01",
      "text": "Rain ticks on the window. ARJUN counts the till, alone, one lamp lit.",
      "type": "action",
      "start_seconds": 0.0,
      "duration_seconds": 4.06
    },
    {
      "character_id": null,
      "id": "SC-001-E02",
      "text": "The door chimes. NILA enters, shaking rain from her coat, a worn paperback in her hand.",
      "type": "action",
      "start_seconds": 4.06,
      "duration_seconds": 5.0
    },
    {
      "character_id": "C-002",
      "id": "SC-001-E03",
      "text": "We're closed.",
      "type": "dialogue",
      "start_seconds": 9.06,
      "duration_seconds": 1.09
    },
    {
      "character_id": "C-001",
      "id": "SC-001-E04",
      "text": "I know. I only need a minute.",
      "type": "dialogue",
      "start_seconds": 10.15,
      "duration_seconds": 2.94
    },
    {
      "character_id": null,
      "id": "SC-001-E05",
      "text": "She sets the paperback on the counter. He doesn't touch it.",
      "type": "action",
      "start_seconds": 13.09,
      "duration_seconds": 3.44
    },
    {
      "character_id": "C-001",
      "id": "SC-001-E06",
      "text": "It's yours. I kept it two years. Longer than I meant to.",
      "type": "dialogue",
      "start_seconds": 16.53,
      "duration_seconds": 4.79
    },
    {
      "character_id": "C-002",
      "id": "SC-001-E07",
      "text": "too lightly",
      "type": "parenthetical",
      "start_seconds": 21.32,
      "duration_seconds": 0.6
    },
    {
      "character_id": "C-002",
      "id": "SC-001-E08",
      "text": "You could have mailed it.",
      "type": "dialogue",
      "start_seconds": 21.92,
      "duration_seconds": 2.2
    },
    {
      "character_id": "C-001",
      "id": "SC-001-E09",
      "text": "Then I wouldn't have had to see the shop.",
      "type": "dialogue",
      "start_seconds": 24.12,
      "duration_seconds": 3.68
    },
    {
      "character_id": null,
      "id": "SC-001-E10",
      "text": "A pause. The rain fills it. Nila's eyes drift to a crooked shelf of poetry.",
      "type": "action",
      "start_seconds": 27.8,
      "duration_seconds": 4.69
    },
    {
      "character_id": "C-001",
      "id": "SC-001-E11",
      "text": "You never fixed that shelf.",
      "type": "dialogue",
      "start_seconds": 32.49,
      "duration_seconds": 2.2
    },
    {
      "character_id": "C-002",
      "id": "SC-001-E12",
      "text": "It leans toward the door. Waiting for someone to leave.",
      "type": "dialogue",
      "start_seconds": 34.69,
      "duration_seconds": 4.05
    },
    {
      "character_id": null,
      "id": "SC-001-E13",
      "text": "Nila laughs, small, then stops herself. She turns to go.",
      "type": "action",
      "start_seconds": 38.74,
      "duration_seconds": 3.12
    },
    {
      "character_id": "C-002",
      "id": "SC-001-E14",
      "text": "Nila. Open it.",
      "type": "dialogue",
      "start_seconds": 41.86,
      "duration_seconds": 1.46
    },
    {
      "character_id": null,
      "id": "SC-001-E15",
      "text": "She stops. He nods at the book. She opens it. Inside: a train ticket to her city, two years old, unused.",
      "type": "action",
      "start_seconds": 43.32,
      "duration_seconds": 6.56
    },
    {
      "character_id": "C-001",
      "id": "SC-001-E16",
      "text": "You bought this.",
      "type": "dialogue",
      "start_seconds": 49.88,
      "duration_seconds": 1.46
    },
    {
      "character_id": "C-002",
      "id": "SC-001-E17",
      "text": "The day after you left. I stood on the platform until the train pulled away.",
      "type": "dialogue",
      "start_seconds": 51.34,
      "duration_seconds": 5.91
    },
    {
      "character_id": "C-001",
      "id": "SC-001-E18",
      "text": "Why tell me now?",
      "type": "dialogue",
      "start_seconds": 57.25,
      "duration_seconds": 1.83
    },
    {
      "character_id": "C-002",
      "id": "SC-001-E19",
      "text": "Because you leave at dawn, and I'm still counting the till.",
      "type": "dialogue",
      "start_seconds": 59.08,
      "duration_seconds": 4.42
    },
    {
      "character_id": null,
      "id": "SC-001-E20",
      "text": "Nila folds the ticket along its old crease. Her hand trembles. His does too.",
      "type": "action",
      "start_seconds": 63.5,
      "duration_seconds": 4.38
    },
    {
      "character_id": "C-001",
      "id": "SC-001-E21",
      "text": "Ask me.",
      "type": "dialogue",
      "start_seconds": 67.88,
      "duration_seconds": 1.09
    },
    {
      "character_id": "C-002",
      "id": "SC-001-E22",
      "pause_seconds": 1.5,
      "text": "Stay.",
      "type": "dialogue",
      "start_seconds": 68.97,
      "duration_seconds": 2.22
    },
    {
      "character_id": null,
      "id": "SC-001-E23",
      "text": "She holds his gaze. Doesn't answer. Pockets the ticket, leaves the book on the counter, and walks to the door.",
      "type": "action",
      "start_seconds": 71.19,
      "duration_seconds": 6.25
    },
    {
      "character_id": null,
      "id": "SC-001-E24",
      "text": "At the threshold she stops, turns the CLOSED sign to OPEN, and steps out into the rain, leaving the door ajar.",
      "type": "action",
      "start_seconds": 77.44,
      "duration_seconds": 6.56
    }
  ],
